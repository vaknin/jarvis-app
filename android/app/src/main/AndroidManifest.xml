<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- mDNS on the LAN (iroh-mdns-address-lookup). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Calls with Jarvis (CallService): the mic, a self-managed Telecom call, and the call's foreground service. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- MediaKeys: a press's call screen opens from a notification if Android blocked the launch. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Keeps the network up through Doze for the short sync after a wake. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Updates from Jarvis's server (Updater): Android asks once to allow it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Its own updates install without a question once Jarvis is their installer of record (Updater). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- The move from the old app (Move): only an app signed with this key gets in. -->
    <permission android:name="${applicationId}.MOVE" android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.MOVE" />
    <!-- The guide's "Remove the old app": Android still asks. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- The phone's own speech to text on calls (PhoneStt): the recognizer service must be visible. The old app, for the move. -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <package android:name="${oldApp}" />
    </queries>

    <application
        android:name=".JarvisApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Design">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The chat with the laptop, one tap from home. -->
        <activity
            android:name=".LaptopActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Aviv's tracked tasks, one tap from home. -->
        <activity
            android:name=".TasksActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- The forum (a WebView), one tap from home. Its own task: back at its start leaves the page alive. -->
        <activity
            android:name=".forum.ForumActivity"
            android:exported="true"
            android:label="Forum"
            android:launchMode="singleTask"
            android:taskAffinity="com.kivan.jarvis.forum"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="jarvis.localhost" android:port="8080" />
            </intent-filter>
        </activity>

        <!-- A call with Jarvis: the big button, Mute and Hang up, over the lock screen. An assist request calls. -->
        <activity
            android:name=".CallActivity"
            android:exported="true"
            android:label="Jarvis"
            android:launchMode="singleTask"
            android:taskAffinity="com.kivan.jarvis.call"
            android:showWhenLocked="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Jarvis as the digital assistant: holding the power button calls him (Assist.kt). -->
        <service
            android:name=".Assistant"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assistant" />
        </service>
        <service
            android:name=".AssistantSessions"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service
            android:name=".AssistantRecognizer"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <!-- Media keys after a call (MediaKeys.kt): the AirPods' double-press calls Jarvis. -->
        <receiver
            android:name=".MediaKeys$Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone" />

        <!-- Quick Settings: "Jarvis", a tap calls, another hangs up. -->
        <service
            android:name=".JarvisTile"
            android:exported="true"
            android:icon="@drawable/lucide_phone"
            android:label="Jarvis"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- The "Laptop" Direct Share tile and the plain share-sheet entry. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <provider
            android:name=".MoveProvider"
            android:authorities="${applicationId}.move"
            android:exported="true"
            android:permission="${applicationId}.MOVE" />

        <!-- Keeps the process and the CPU up for the minutes the move takes. -->
        <service
            android:name=".MoveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Moves the owner's data over from the app this one replaced, once, while he waits" />
        </service>

        <!-- Keeps the process up, so the forum tunnel's localhost port answers and the forum's notifications come. -->
        <service
            android:name=".LinkService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the owner's home forum tunnel answering on localhost and long-polls it for posts aimed at him, to notify without Google services" />
        </service>

        <!-- The laptop's wake (FCM): the phone dials it and takes what it queued. -->
        <service
            android:name=".WakeMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Android's installer reports an update here (its question, done, or why not). -->
        <receiver
            android:name=".Updater$StatusReceiver"
            android:exported="false" />

        <!-- Jarvis calling: Decline, and a missed callback dismissed (Callback). -->
        <receiver
            android:name=".Callback$Action"
            android:exported="false" />

        <!-- A forum notification's Reply and its dismissal. -->
        <receiver
            android:name=".forum.Actions"
            android:exported="false" />

        <!-- Reply and Mark as read on the message notification. -->
        <receiver
            android:name=".ReplyReceiver"
            android:exported="false" />
    </application>

</manifest>
